# MCP as a Judge Configuration
# Copy this file to .env and configure your settings

# Transport Configuration
# Options: "stdio" or "sse"
TRANSPORT=stdio

# Server Configuration (for SSE transport)
HOST=0.0.0.0
PORT=8050

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development Settings
DEBUG=false
DEVELOPMENT_MODE=false

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Performance Settings
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Security Settings
CORS_ENABLED=false
CORS_ORIGINS=*

# =============================================================================
# LLM API Configuration
# =============================================================================
# MCP as a Judge defaults to DeepSeek Reasoner for advanced code understanding
# and reasoning capabilities. Configure these settings when MCP sampling is not
# available (required for most AI assistants except GitHub Copilot + VS Code).
#
# Recommended: DeepSeek API
# - Get your API key from https://platform.deepseek.com/
# - Default model: deepseek-reasoner
# - Default base URL: https://api.deepseek.com/v1
#
# Method 1: DeepSeek-specific variables (recommended for clarity)
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  # Optional, uses default if not set
# MODEL=deepseek-reasoner  # Optional, uses default if not set
#
# Method 2: Unified LLM variables (works with any provider)
# LLM_API_KEY=your-api-key-here
# LLM_MODEL_NAME=deepseek-reasoner  # Or any supported model
# LLM_BASE_URL=https://api.deepseek.com/v1  # Optional for custom endpoints
#
# Other supported providers (using unified variables):
# - OpenAI: LLM_API_KEY=sk-... LLM_MODEL_NAME=gpt-4.1
# - Anthropic: LLM_API_KEY=sk-ant-... LLM_MODEL_NAME=claude-sonnet-4-20250514
# - Google: LLM_API_KEY=AIza... LLM_MODEL_NAME=gemini-2.5-pro
# - Groq: LLM_API_KEY=gsk_... LLM_MODEL_NAME=deepseek-r1
# See README.md for all supported providers

# Example MCP Client Configuration
# Add this to your Claude Desktop or Cursor configuration:
#
# For SSE Transport:
# {
#   "mcpServers": {
#     "mcp-as-a-judge": {
#       "transport": "sse",
#       "url": "http://localhost:8050/sse"
#     }
#   }
# }
#
# For Stdio Transport:
# {
#   "mcpServers": {
#     "mcp-as-a-judge": {
#       "command": "uv",
#       "args": ["run", "mcp-as-a-judge"],
#       "env": {
#         "TRANSPORT": "stdio",
#         "DEEPSEEK_API_KEY": "your-deepseek-api-key-here",
#         "MODEL": "deepseek-reasoner"
#       }
#     }
#   }
# }
