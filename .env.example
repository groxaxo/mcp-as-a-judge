# MCP as a Judge Configuration
# Copy this file to .env and configure your settings

# Transport Configuration
# Options: "stdio" or "sse"
TRANSPORT=stdio

# Server Configuration (for SSE transport)
HOST=0.0.0.0
PORT=8050

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development Settings
DEBUG=false
DEVELOPMENT_MODE=false

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Performance Settings
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Security Settings
CORS_ENABLED=false
CORS_ORIGINS=*

# LLM API Configuration (Optional - for fallback when MCP sampling unavailable)
# Uncomment and set these to use an LLM API provider
# Recommended: DeepSeek for advanced reasoning capabilities
# LLM_API_KEY=your-deepseek-api-key-here
# LLM_MODEL_NAME=deepseek-reasoner
#
# Other supported providers:
# - OpenAI: LLM_API_KEY=sk-... LLM_MODEL_NAME=gpt-4.1
# - Anthropic: LLM_API_KEY=sk-ant-... LLM_MODEL_NAME=claude-sonnet-4-20250514
# - Google: LLM_API_KEY=AIza... LLM_MODEL_NAME=gemini-2.5-pro
# See README.md for all supported providers

# Example MCP Client Configuration
# Add this to your Claude Desktop or Cursor configuration:
#
# For SSE Transport:
# {
#   "mcpServers": {
#     "mcp-as-a-judge": {
#       "transport": "sse",
#       "url": "http://localhost:8050/sse"
#     }
#   }
# }
#
# For Stdio Transport:
# {
#   "mcpServers": {
#     "mcp-as-a-judge": {
#       "command": "uv",
#       "args": ["run", "mcp-as-a-judge"],
#       "env": {
#         "TRANSPORT": "stdio",
#         "LLM_API_KEY": "your-deepseek-api-key-here",
#         "LLM_MODEL_NAME": "deepseek-reasoner"
#       }
#     }
#   }
# }
